{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@4xian/jword-core": ["./packages/core/src/index.ts"],
      "@4xian/jword-docx": ["./packages/docx/src/index.ts"],
      "@4xian/jword-docx/worker": ["./packages/docx/src/worker.ts"],
      "@4xian/jword-pdf": ["./packages/pdf/src/index.ts"],
      "@4xian/jword-pdf/worker": ["./packages/pdf/src/worker.ts"],
      "@4xian/jword-ui": ["./packages/ui/src/index.ts"],
      "@4xian/jword-ui/styles.css": ["./packages/ui/src/styles/toolbar.css"]
    },
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
